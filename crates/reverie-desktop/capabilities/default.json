{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by the ReverieAgent desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-exists"
  ]
}
