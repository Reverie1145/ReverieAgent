{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReverieAgent",
  "version": "0.1.0",
  "identifier": "com.reverieagent.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../apps/desktop run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../../apps/desktop run build",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReverieAgent",
        "width": 1480,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
